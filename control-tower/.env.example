# Passcode the senior rep types on /login
OPERATOR_PASSCODE=
# Random secret (32+ chars) that signs the session cookie
SESSION_SECRET=
# Adapter base URL and its operator key (never the agent key)
ADAPTER_URL=http://localhost:8080
OPERATOR_API_KEY=
# HappyRobot org key and the inbound-carrier-sales workflow id
# Use a key separate from the adapter's: the API allows 300 requests/minute per key
HAPPYROBOT_API_KEY=
WORKFLOW_ID=
# HappyRobot environment signals are published to: development, staging or production (default development)
HAPPYROBOT_ENVIRONMENT=development
