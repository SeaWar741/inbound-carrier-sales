PORT=8080

# Legacy TMS (TCP)
TMS_HOST=
TMS_PORT=
TMS_TOKEN=

# FMCSA QCMobile web key
FMCSA_API_KEY=

# HappyRobot public API key (sk_live_...)
HAPPYROBOT_API_KEY=

# Callers of this adapter: the HappyRobot agent workflow and the control tower
AGENT_API_KEY=
OPERATOR_API_KEY=

# OTP delivery: "demo" sends every code to the demo recipients below; "live" sends to the carrier's contact on file
OTP_DELIVERY_MODE=demo
OTP_DEMO_EMAIL=
# Only needed when OTP_SMS_WORKFLOW_ID is set
OTP_DEMO_PHONE=
# Local simulator only: pins every OTP to this 6-digit code; refused unless TMS_HOST is 127.0.0.1/localhost and delivery is demo
OTP_FIXED_CODE=
# Random secret (32+ chars) that keys the stored OTP hash
OTP_HASH_SECRET=
# Delivery workflows created by `npm run push:workflow -- otp-email | otp-sms`
OTP_EMAIL_WORKFLOW_ID=
OTP_SMS_WORKFLOW_ID=
HAPPYROBOT_ENVIRONMENT=development

# Public URL of this adapter, baked into the agent's tool webhooks by `npm run push:workflow -- inbound-carrier-sales`
ADAPTER_URL=

# Only for `npm run push:workflow -- otp-sms`: the Twilio credential stored in HappyRobot
TWILIO_CREDENTIAL_ID=
TWILIO_PHONE_NUMBER=
