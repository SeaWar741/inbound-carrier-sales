{
  "name": "inbound-carrier-sales",
  "version": "0.1.0",
  "description": "TMS adapter and HappyRobot workflow for inbound carrier sales",
  "scripts": {
    "test": "vitest run",
    "start": "node src/server.ts",
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc",
    "bootstrap:twin": "node --env-file-if-exists=.env scripts/bootstrap-twin.ts",
    "smoke:tms": "node --env-file-if-exists=.env scripts/tms-smoke.ts",
    "push:workflow": "node --env-file-if-exists=.env workflow/push.ts"
  },
  "type": "module",
  "dependencies": {
    "@happyrobot-ai/sdk": "^0.1.51",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@happyrobot-ai/workflow-sdk": "^0.1.11",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "private": true,
  "engines": {
    "node": ">=25"
  }
}
